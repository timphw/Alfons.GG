# Riot Developer / Personal API Key (https://developer.riotgames.com) – NUR serverseitig!
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Postgres (z.B. Neon über Vercel Marketplace) – ab Phase 3/4 benötigt
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Redis (z.B. Upstash) – optional in Phase 1/2 (sonst In-Memory-Cache)
REDIS_URL=

# Secret zum Signieren der Companion-Pairing-Tokens (z.B. `openssl rand -hex 32`)
COMPANION_TOKEN_SECRET=change-me
